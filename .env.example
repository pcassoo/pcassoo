# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Application (client) ID — found on the General Information page of your app
DISCORD_CLIENT_ID=

# The channel ID where lead notifications will be posted
# Right-click the channel in Discord → Copy Channel ID (Developer Mode must be on)
DISCORD_CHANNEL_ID=

# ── GoHighLevel ───────────────────────────────────────────────────────────────
# Webhook secret for verifying GHL requests (optional but recommended)
# Set this in GHL → Settings → Webhooks → Signing Secret
GHL_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL of your deployed app (used by the bot's /leads status command)
NEXT_PUBLIC_BASE_URL=https://your-domain.com
